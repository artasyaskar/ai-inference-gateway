# ============================================
# AI Inference Gateway - Environment Variables
# ============================================

# Application
APP_NAME=AI Inference Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inference_gateway
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inference_gateway
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=4

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production-here-is-a-long-key-for-hs256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PRO_TIER=10000
RATE_LIMIT_ENTERPRISE_TIER=100000

# Model Configuration
MODEL_CACHE_DIR=./models_cache
DEVICE=cpu
BATCH_SIZE=32
BATCH_WAIT_TIME_MS=100
MAX_SEQUENCE_LENGTH=512

# Inference Engine
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=60
ENABLE_MODEL_FALLBACK=true
CACHE_TTL_SECONDS=86400

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Feature Flags
ENABLE_BATCHING=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_ASYNC_PROCESSING=true

# Supported Models (comma-separated list)
# Format: model_name:model_path_or_hf_id:task_type
SUPPORTED_MODELS=gpt2:gpt2:text-generation,all-MiniLM-L6-v2:sentence-transformers/all-MiniLM-L6-v2:embeddings
